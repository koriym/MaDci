{
    "name": "koriym/ma-dci",
    "authors": [
        {
            "name": "Akihito Koriyama"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0",
        "squizlabs/php_codesniffer": "^3.10",
        "friendsofphp/php-cs-fixer": "^3.60",
        "phpmd/phpmd": "^2.15"
    },
    "autoload": {
        "psr-4": {
            "Koriym\\MaDci\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koriym\\MaDci\\": "tests/",
            "Koriym\\DciExample\\": "example/"
        }
    },
    "scripts": {
        "test": [
            "phpmd src text ./phpmd.xml",
            "@cs",
            "phpunit"
        ],
        "coverage": [
            "XDEBUG_MODE=coverage ./vendor/bin/phpunit --coverage-text --coverage-html=build/coverage"
        ],
        "cs": [
            "php-cs-fixer fix -v --dry-run --diff",
            "phpcs --standard=./phpcs.xml src"
        ],
        "cs-fix": [
            "php-cs-fixer fix -v",
            "phpcbf src"
        ],
        "build": [
            "rm -rf ./build; mkdir -p ./build/logs ./build/pdepend",
            "pdepend --jdepend-xml=./build/logs/jdepend.xml --jdepend-chart=./build/pdepend/dependencies.svg --overview-pyramid=./build/pdepend/overview-pyramid.svg src",
            "phploc --log-csv ./build/logs/phploc.csv src",
            "@cs",
            "@test"
        ]
    }
}
